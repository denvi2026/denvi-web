# Local Spring Boot server. Set a deployed HTTPS endpoint for production builds.
VITE_API_BASE_URL=http://localhost:8080

# Browser-side wait limit for one restoration job, in milliseconds (default 600000 = 10 minutes).
# Exceeding it only stops waiting in the browser; the server job keeps running and can be checked again.
# VITE_RESTORATION_MAX_WAIT_MS=600000
